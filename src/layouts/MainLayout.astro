---
import Sidebar from "../components/Sidebar.astro";

const currentPath = Astro.url.pathname;
---
<div class="page-layout">
  <Sidebar currentPath={currentPath} />

  <main class="page-content">
    <slot />
  </main>
</div>

<style>
  .page-layout {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    min-height: 100vh;
    width: 100%;
  }

  .page-content {
    flex: 1;
    min-width: 0;
    padding: 24px;
  }
</style>