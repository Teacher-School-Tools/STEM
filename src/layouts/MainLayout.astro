---
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import HeaderDropdown from "../components/HeaderDropdown.astro";
import "../styles/global.css"

const { title = "SCH3U Curriculum Resources" } = Astro.props;
---

<script is:inline>
  (() => {
    const isCollapsed =
      localStorage.getItem("sidebar-collapsed") === "true";

    document.documentElement.classList.toggle(
      "sidebar-initially-collapsed",
      isCollapsed
    );
  })();
</script>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <HeaderDropdown></HeaderDropdown>
  </head>

  <body>
    <div class="site-layout">
      <div class="main-container">
        <div class="sidebar-space">
          <Sidebar />
        </div>

        <main class="page-content">
          <div class="content-wrapper">
            <slot />
          </div>
        </main>
      </div>

      <Footer />
    </div>
  </body>
</html>

<style>

:global(*) {
  box-sizing: border-box;
}

:global(html),
:global(body) {
  margin: 0;
  min-height: 100%;
  width: 100%;
}

.site-layout {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  width: 100%;
}

.main-container {
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr);
  flex: 1 0 auto;
  align-items: stretch;
  width: 100%;
  min-width: 0;
}

.sidebar-space {
  grid-column: 1;
  grid-row: 1;
  position: relative;
  width: 220px;
  min-width: 0;
  height: 100%;
}

.page-content {
  grid-column: 2;
  grid-row: 1;
  display: block;
  width: 100%;
  min-width: 0;
  max-width: none;
  padding: 0 16px 2rem;
}

.content-wrapper {
  width: 75%;
  margin-left: auto;
  margin-right: auto;
  position: relative;
}

</style>
