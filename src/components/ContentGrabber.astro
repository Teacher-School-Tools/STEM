---
import MainLayout from "../layouts/MainLayout.astro";

interface Props {
  dirIn: string;
}

const { dirIn } = Astro.props;

// Normalize directory path
const directory = dirIn.endsWith("/")
  ? dirIn
  : `${dirIn}/`;

// Automatically discover pages and import their descriptions
const pageFiles = import.meta.glob("../pages/**/*.astro", {
  eager: true,
  import: "description"
});

// Build page information
const pages = Object.entries(pageFiles)
  .filter(([path]) => {
    // Only include pages directly inside the specified directory
    const normalizedPath = path.replace(/\\/g, "/");

    return (
      normalizedPath.startsWith(`../pages${directory}`) &&
      normalizedPath.slice(`../pages${directory}`.length).indexOf("/") === -1 &&
      !normalizedPath.endsWith("/index.astro")
    );
  })
  .map(([path, description]) => {
    // Extract filename
    const filename = path.split("/").pop().replace(/\.astro$/, "");

    // Generate readable title
    const title = filename
      .replace(/^\d+-/, "")
      .replace(/-/g, " ")
      .replace(/\b\w/g, char => char.toUpperCase());

    // Generate page URL
    const href = path
      .replace("../pages/", "")
      .replace(/\.astro$/, "");

    return {
      title,
      href,
      description: description ?? "Temporary description",
      filename
    };
  })
  // Sort alphanumerically
  .sort((a, b) =>
    a.filename.localeCompare(b.filename, undefined, {
      numeric: true,
      sensitivity: "base"
    })
  );
---

<MainLayout>
  <h1>Contents</h1>

  <div class="page-list">
    {pages.map((page) => (
      <div class="page-item">
        <h2>
          <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/${page.href}/`}>
            {page.title}
          </a>
        </h2>

        <p>{page.description}</p>
      </div>
    ))}
  </div>
</MainLayout>

<style>
  .page-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .page-item {
    padding-bottom: 1rem;
    border-bottom: 1px solid #ddd;
  }

  .page-item h2 {
    margin: 0 0 0.4rem;
    font-size: 1.25rem;
  }

  .page-item h2 a {
    color: inherit;
    text-decoration: none;
  }

  .page-item h2 a:hover {
    text-decoration: underline;
  }

  .page-item p {
    margin: 0;
    color: #666;
    line-height: 1.5;
  }
</style>
