---
import glossaryText from "./glossary.txt?raw";

interface Props {
    term: string;
}
const base = import.meta.env.BASE_URL + "/09-Appendices/glossary";

const { term } = Astro.props;

// Normalize terms before comparison
const normalizeTerm = (value: string) =>
    value
        .normalize("NFKC")
        .trim()
        .replace(/\s+/g, " ")
        .toLowerCase();

// Parse glossary
const glossaryEntries = glossaryText
    .split(/\r?\n/)
    .filter(line => line.trim() !== "")
    .map(line => {
        const separatorIndex = line.indexOf("|");

        if (separatorIndex === -1) return null;

        return {
            term: line.substring(0, separatorIndex).trim(),
            definition: line.substring(separatorIndex + 1).trim()
        };
    })
    .filter(entry => entry !== null);

// Find matching definition
const matchingEntry = glossaryEntries.find(
    entry => normalizeTerm(entry.term) === normalizeTerm(term)
);

const definition = matchingEntry?.definition ?? "Definition not found.";
---

<a
    href={base +"/#"+ term.replace(/\s+/g, "-")}
    class="glossary-term"
    aria-label={`${term}: ${definition}. Click to view glossary entry.`}
>
    {term}
    <span class="tooltip" role="tooltip">
        {definition}
    </span>
</a>

<style>
    .glossary-term {
        position: relative;
        display: inline-block;
        color: #2563eb;
        text-decoration: underline;
        text-decoration-style: dotted;
        text-underline-offset: 3px;
        cursor: pointer;
    }

    .tooltip {
        visibility: hidden;
        opacity: 0;
        position: absolute;
        bottom: 125%;
        left: 50%;
        transform: translateX(-50%);
        width: max-content;
        max-width: 280px;
        padding: 10px 12px;
        background: #1f2937;
        color: white;
        border-radius: 6px;
        font-size: 0.875rem;
        line-height: 1.5;
        text-decoration: none;
        z-index: 100;
        pointer-events: none;
        transition: opacity 0.15s ease;
    }

    .glossary-term:hover .tooltip,
    .glossary-term:focus-visible .tooltip {
        visibility: visible;
        opacity: 1;
    }
</style>
