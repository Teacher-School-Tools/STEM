---
interface Props {
    gameName: string;
    gameDir: string;
}

const { gameName, gameDir } = Astro.props;
---

<h1>{gameName}</h1>

<div class="game-container">

    <div class="info-panel">
    <p>Use the left and right arrow keys to aim the cannon.</p>
    <p>Press SPACE to fire projectiles.</p>
    <p>Collect the atoms to earn points.</p>
    </div>

    <canvas
        id="gameCanvas"
        width="600"
        height="400"
        tabindex="0"
    ></canvas>

    <div class="game-controls">

        <!-- Level selector -->
        <div class="level-control">
        <label for="levelSelector">Select Level:</label>

        <select id="levelSelector">
            <option value="level1">Level 1</option>
            <option value="level2">Level 2</option>
            <option value="level3">Level 3</option>
        </select>
    </div>

    <div class="game-buttons">
            <button id="startGame">Start</button>
            <button id="pauseGame">Pause</button>
            <button id="restartGame">Restart</button>
    </div>

        <div class="temperature-control">
            <label for="temperature">
                Temperature: <span id="temperatureValue">298 K</span>
            </label>

            <input
                type="range"
                id="temperature"
                min="298"
                max="798"
                value="298"
                step="1"
            />
        </div>

        <div class="atom-control">
            <label for="atomCount">
                Number of Atoms: <span id="atomCountValue">5</span>
            </label>

            <input
                type="range"
                id="atomCount"
                min="1"
                max="50"
                value="5"
                step="1"
            />
        </div>

        

    </div>

</div>

<script>

import Game from "../game/projects/NuclearGame.js";

const canvas = document.querySelector("#gameCanvas");
const startButton = document.querySelector("#startGame");
const pauseButton = document.querySelector("#pauseGame");
const restartButton = document.querySelector("#restartGame");

if (
    canvas instanceof HTMLCanvasElement &&
    startButton &&
    pauseButton &&
    restartButton
) {

    const game = new Game(canvas);

    // Level selector
    const levelSelector = document.querySelector("#levelSelector");

    if (levelSelector instanceof HTMLSelectElement) {
        levelSelector.addEventListener("change", () => {

            const selectedLevel = levelSelector.value;

            // Change the active game scene
            if (typeof game.setLevel === "function") {
                game.setLevel(selectedLevel);
            }

            canvas.focus();
        });
    }

    // Temperature slider
    const slider = document.querySelector("#temperature");
    const temperatureValue = document.querySelector("#temperatureValue");

    if (
        slider instanceof HTMLInputElement &&
        temperatureValue
    ) {
        slider.addEventListener("input", () => {
            const temperature = Number(slider.value);

            temperatureValue.textContent = `${temperature} K`;

            game.setTemperature(temperature);
        });
    }

    // Atom count slider
    const Atomslider = document.querySelector("#atomCount");
    const atomValue = document.querySelector("#atomCountValue");

    if (
        Atomslider instanceof HTMLInputElement &&
        atomValue
    ) {
        Atomslider.addEventListener("input", () => {
            const count = Number(Atomslider.value);

            atomValue.textContent = count.toString();

            game.setAtomCount(count);
        });
    }

    // Canvas focus
    canvas.addEventListener("click", () => {
        canvas.focus();
    });

    // Start
    startButton.addEventListener("click", () => {
        if (!game.running) {
            game.start();
            canvas.focus();
        }
    });

    // Pause / Resume
    pauseButton.addEventListener("click", () => {
        if (game.state === "playing") {
            game.pause();
        } else if (game.state === "paused") {
            game.resume();
        }

        canvas.focus();
    });

    // Restart
    restartButton.addEventListener("click", () => {
        game.restart();
        canvas.focus();
    });

}
    const levelSelector = document.querySelector("#levelSelector");

    if (levelSelector instanceof HTMLSelectElement) {

        levelSelector.addEventListener("change", () => {

            game.setLevel(levelSelector.value);

            canvas.focus();

        });

    }

// Prevent page scrolling while using game controls
document.addEventListener("keydown", (event) => {

    const gameKeys = [
        "ArrowUp",
        "ArrowDown",
        "ArrowLeft",
        "ArrowRight",
        " ",
        "w",
        "a",
        "s",
        "d",
        "W",
        "A",
        "S",
        "D"
    ];

    if (gameKeys.includes(event.key)) {
        event.preventDefault();
    }

});
</script>

<style>
.game-container {
    display: grid;
    grid-template-columns: 1fr minmax(0, 600px) 1fr;
    gap: 20px;
    width: 95%;
    margin: 2rem auto;
    align-items: start;
}

/* Keep canvas centered */
canvas {
    grid-column: 2;
    width: 100%;
    height: auto;
    border: 2px solid #333;
    background: #f5f5f5;
}

/* Position controls to the right */
.game-controls {
    grid-column: 3;
    display: flex;
    flex-direction: column;
    gap: 15px;
    width: 100%;
}

.game-controls label {
    display: block;
}

.game-controls input,
.game-controls select {
    width: 100%;
    margin: 5px 0 15px;
}

.game-controls select {
    padding: 8px;
    cursor: pointer;
}

.game-controls button {
    width: 100%;
    padding: 10px;
    cursor: pointer;
}

/* Game buttons */
.game-buttons {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

/* Smaller screens */
@media (max-width: 850px) {
    .game-container {
        grid-template-columns: 1fr;
        width: 95%;
    }

    canvas {
        grid-column: 1;
    }

    .game-controls {
        grid-column: 1;
        max-width: 400px;
        margin: auto;
    }
}
</style>
