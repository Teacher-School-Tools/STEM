---
interface Props {
    gameName: string;
    gameDir: string;
}

const { gameName, gameDir } = Astro.props;
---

<div class="game-header">
    <h1>{gameName}</h1>

    <button
        id="openInstructions"
        class="instructions-button"
        aria-label="Open game instructions"
        title="Game instructions"
    >
        i
    </button>
</div>
<div class="game-container">
    <div class="instructions-modal" id="instructionsModal">
    <div class="instructions-content">
        <button
            class="close-instructions"
            id="closeInstructions"
            aria-label="Close instructions"
        >
            &times;
        </button>

        <h2>Game Instructions</h2>

        <div class="preamble">
            <p>Use the left and right arrow keys to aim the cannon. The up and down arrow keys can be used for finer movement.</p>
            <p>Press SPACE to fire neutrons.</p>
            <p>Your goal is to minimize the number of neutrons you shoot to achieve your goal, as each shot costs a LOT of money!</p>
        </div>
    </div>
</div>

    <canvas
        id="gameCanvas"
        width="600"
        height="400"
        tabindex="0"
    ></canvas>

    <div class="game-controls">

        <!-- Level selector -->
        <div class="level-control">
        <label for="levelSelector">Select Level:</label>

        <select id="levelSelector">
            <option value="level1">Level 1</option>
            <option value="level2">Level 2</option>
            <option value="level3">Level 3</option>
        </select>
    </div>

    <div class="game-buttons">
            <button id="startGame">Start</button>
            <button id="pauseGame">Pause</button>
            <button id="restartGame">Restart</button>
    </div>

        <div class="temperature-control">
            <label for="temperature">
                Temperature: <span id="temperatureValue">298 K</span>
            </label>

            <input
                type="range"
                id="temperature"
                min="298"
                max="798"
                value="298"
                step="1"
            />
        </div>

        <div class="atom-control">
            <label for="atomCount">
                Number of Atoms: <span id="atomCountValue">5</span>
            </label>

            <input
                type="range"
                id="atomCount"
                min="1"
                max="50"
                value="5"
                step="1"
            />
        </div>

        

    </div>

</div>

<script>

import Game from "../game/projects/NuclearGame.js";

const canvas = document.querySelector("#gameCanvas");
const startButton = document.querySelector("#startGame");
const pauseButton = document.querySelector("#pauseGame");
const restartButton = document.querySelector("#restartGame");

const instructionsModal = document.getElementById("instructionsModal");
const closeInstructions = document.getElementById("closeInstructions");
const openInstructions = document.getElementById("openInstructions");

// Show instructions when the page loads
instructionsModal.style.display = "flex";

// Close instructions
closeInstructions.addEventListener("click", () => {
    instructionsModal.style.display = "none";
});

// Reopen instructions
openInstructions.addEventListener("click", () => {
    instructionsModal.style.display = "flex";
});

// Close when clicking outside the popup
instructionsModal.addEventListener("click", (event) => {
    if (event.target === instructionsModal) {
        instructionsModal.style.display = "none";
    }
});

// Close with Escape
document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
        instructionsModal.style.display = "none";
    }
});

if (
    canvas instanceof HTMLCanvasElement &&
    startButton &&
    pauseButton &&
    restartButton
) {

    const game = new Game(canvas);

    // Level selector
    const levelSelector = document.querySelector("#levelSelector");

    if (levelSelector instanceof HTMLSelectElement) {
        levelSelector.addEventListener("change", () => {

            const selectedLevel = levelSelector.value;

            // Change the active game scene
            if (typeof game.setLevel === "function") {
                game.setLevel(selectedLevel);
            }

            canvas.focus();
        });
    }

    // Temperature slider
    const slider = document.querySelector("#temperature");
    const temperatureValue = document.querySelector("#temperatureValue");

    if (
        slider instanceof HTMLInputElement &&
        temperatureValue
    ) {
        slider.addEventListener("input", () => {
            const temperature = Number(slider.value);

            temperatureValue.textContent = `${temperature} K`;

            game.setTemperature(temperature);
        });
    }

    // Atom count slider
    const Atomslider = document.querySelector("#atomCount");
    const atomValue = document.querySelector("#atomCountValue");

    if (
        Atomslider instanceof HTMLInputElement &&
        atomValue
    ) {
        Atomslider.addEventListener("input", () => {
            const count = Number(Atomslider.value);

            atomValue.textContent = count.toString();

            game.setAtomCount(count);
        });
    }

    // Canvas focus
    canvas.addEventListener("click", () => {
        canvas.focus();
    });

    // Start
    startButton.addEventListener("click", () => {
        if (!game.running) {
            game.start();
            canvas.focus();
        }
    });

    // Pause / Resume
    pauseButton.addEventListener("click", () => {
        if (game.state === "playing") {
            game.pause();
        } else if (game.state === "paused") {
            game.resume();
        }

        canvas.focus();
    });

    // Restart
    restartButton.addEventListener("click", () => {
        game.restart();
        canvas.focus();
    });

}
    const levelSelector = document.querySelector("#levelSelector");

    if (levelSelector instanceof HTMLSelectElement) {

        levelSelector.addEventListener("change", () => {

            game.setLevel(levelSelector.value);

            canvas.focus();

        });

    }

// Prevent page scrolling while using game controls
document.addEventListener("keydown", (event) => {

    const gameKeys = [
        "ArrowUp",
        "ArrowDown",
        "ArrowLeft",
        "ArrowRight",
        " ",
        "w",
        "a",
        "s",
        "d",
        "W",
        "A",
        "S",
        "D"
    ];

    if (gameKeys.includes(event.key)) {
        event.preventDefault();
    }

});
</script>

<style>
.game-container {
    display: grid;
    grid-template-columns: 1fr minmax(0, 600px) 1fr;
    gap: 20px;
    width: 95%;
    margin: 2rem auto;
    align-items: start;
}

/* Keep canvas centered */
canvas {
    grid-column: 2;
    width: 100%;
    height: auto;
    border: 2px solid #333;
    background: #f5f5f5;
}

/* Position controls to the right */
.game-controls {
    grid-column: 3;
    display: flex;
    flex-direction: column;
    gap: 15px;
    width: 100%;
}

.game-controls label {
    display: block;
}

.game-controls input,
.game-controls select {
    width: 100%;
    margin: 5px 0 15px;
}

.game-controls select {
    padding: 8px;
    cursor: pointer;
}

.game-controls button {
    width: 100%;
    padding: 10px;
    cursor: pointer;
}

/* Game buttons */
.game-buttons {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

/* Smaller screens */
@media (max-width: 850px) {
    .game-container {
        grid-template-columns: 1fr;
        width: 95%;
    }

    canvas {
        grid-column: 1;
    }

    .game-controls {
        grid-column: 1;
        max-width: 400px;
        margin: auto;
    }
}

.instructions-modal {
    display: none;
    position: fixed;
    z-index: 1000;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);

    justify-content: center;
    align-items: center;

    padding: 20px;
}

.instructions-content {
    position: relative;
    background: white;
    padding: 30px;
    border-radius: 10px;

    width: 100%;
    max-width: 600px;
    max-height: 80vh;
    overflow-y: auto;

    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
}

.instructions-content h2 {
    margin-top: 0;
    margin-bottom: 20px;
}

.close-instructions {
    position: absolute;
    top: 10px;
    right: 15px;

    background: none;
    border: none;

    font-size: 28px;
    cursor: pointer;
}

.close-instructions:hover {
    color: #777;
}

.game-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
}

.game-header h1 {
    margin: 0;
}

.instructions-button {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 22px;
    height: 22px;

    padding: 0;
    border: 2px solid currentColor;
    border-radius: 50%;

    background: transparent;
    color: inherit;

    font-family: serif;
    font-size: 15px;
    font-weight: bold;
    font-style: italic;

    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
}

.instructions-button:hover {
    background: currentColor;
    color: white;
}
</style>
