---
interface Props {
    gameName: string;
    gameDir: string;
}

const { gameName, gameDir } = Astro.props;
---

<!-- =========================================
     Game Header
========================================= -->

<div class="game-header">
    <h1>{gameName}</h1>

    <button
        id="openInstructions"
        class="instructions-button"
        aria-label="Open game instructions"
        title="Game instructions"
    >
        i
    </button>
</div>

<!-- =========================================
     Main Game Layout
========================================= -->

<div class="game-container">

    <!-- Instructions Modal -->
    <div
        class="instructions-modal"
        id="instructionsModal"
        aria-hidden="false"
    >
        <div
            class="instructions-content"
            role="dialog"
            aria-modal="true"
            aria-labelledby="instructionsTitle"
        >
            <button
                class="close-instructions"
                id="closeInstructions"
                aria-label="Close instructions"
            >
                &times;
            </button>

            <h2 id="instructionsTitle">Game Instructions</h2>

            <div class="preamble">
                <p>Use the left and right arrow keys to aim the cannon.</p>
                <p>Use the up and down arrow keys for finer movement.</p>
                <p>Press SPACE to fire neutrons.</p>
                <p>
                    Your goal is to minimize the number of neutrons
                    you shoot, as each shot costs a LOT of money!
                </p>
            </div>
        </div>
    </div>

    <!-- Level Description -->
    <section id="level-description">

        <h2 id="level-description-title">
            Level 1
        </h2>

        <p id="level-description-text">
            Welcome to Level 1.
        </p>

    </section>

    <!-- Canvas and Cannon Settings -->
    <section class="game-canvas-container">

        <canvas
            id="gameCanvas"
            width="600"
            height="400"
            tabindex="0"
            aria-label="Nuclear physics game"
        ></canvas>

        <!-- Cannon Customization -->
        <div class="cannon-settings">

            <h3>Cannon Customization</h3>

            <div class="settings-row">

                <div class="setting">
                    <label for="cannonColor">
                        Cannon Colour
                    </label>

                    <input
                        type="color"
                        id="cannonColor"
                        value="#555555"
                    />
                </div>

                <div class="setting">
                    <label for="cannonEmoji">
                        Cannon Emoji
                    </label>

                    <select id="cannonEmoji">
                        <option value="">None</option>
                        <option value="🚀">Rocket</option>
                        <option value="🔥">Fire</option>
                        <option value="⭐">Star</option>
                        <option value="💥">Explosion</option>
                        <option value="🐱">Cat</option>
                        <option value="👾">Alien</option>
                        <option value="⚡">Lightning</option>
                        <option value="🌈">Rainbow</option>
                        <option value="☢️">Radioactive</option>
                    </select>
                </div>

            </div>

            <button id="resetCannon">
                Reset Appearance
            </button>

        </div>

    </section>

    <!-- Game Controls -->
    <section class="game-controls">

        <!-- Level Selection -->
        <div class="control-group">

            <label for="levelSelector">
                Select Level
            </label>

            <select id="levelSelector">
                <option value="level0">Practice</option>
                <option value="level1">Level 1</option>
                <option value="level2">Level 2</option>
                <option value="level3">Level 3</option>
            </select>

        </div>

        <!-- Game Buttons -->
        <div class="game-buttons">
            <button id="startGame">Start</button>
            <button id="pauseGame">Pause</button>
            <button id="restartGame">Restart</button>
        </div>

        <!-- Level 4 Controls -->
        <div id="level0-controls" class="level0-controls">

            <div class="control-group">

                <label for="temperature">
                    Temperature:
                    <span id="temperatureValue">298 K</span>
                </label>

                <input
                    type="range"
                    id="temperature"
                    min="298"
                    max="798"
                    value="298"
                    step="1"
                />

            </div>

            <div class="control-group">

                <label for="atomCount">
                    Number of Atoms:
                    <span id="atomCountValue">5</span>
                </label>

                <input
                    type="range"
                    id="atomCount"
                    min="1"
                    max="50"
                    value="5"
                    step="1"
                />

            </div>

        </div>

    </section>

</div>

<!-- =========================================
     JavaScript
========================================= -->

<script>
import NuclearGame from "../game/projects/NuclearGame.js";

// =========================================
// DOM Elements
// =========================================

const canvas = document.querySelector("#gameCanvas");

const startButton = document.querySelector("#startGame");
const pauseButton = document.querySelector("#pauseGame");
const restartButton = document.querySelector("#restartGame");

const levelSelector = document.querySelector("#levelSelector");
const level0Controls = document.querySelector("#level0-controls");

const temperatureSlider = document.querySelector("#temperature");
const temperatureValue = document.querySelector("#temperatureValue");

const atomSlider = document.querySelector("#atomCount");
const atomValue = document.querySelector("#atomCountValue");

const cannonColor = document.querySelector("#cannonColor");
const cannonEmoji = document.querySelector("#cannonEmoji");
const resetCannon = document.querySelector("#resetCannon");

const instructionsModal = document.querySelector("#instructionsModal");
const openInstructions = document.querySelector("#openInstructions");
const closeInstructions = document.querySelector("#closeInstructions");

// =========================================
// Level Configuration
// =========================================

const levelDescriptions = {

    level0: {
        title: "Practice Mode",
        description: `
            Customize and learn to control your cannon.
        `
    },

    level1: {
        title: "Level 1: Introduction",
        description: `
            Fire the least number of neutrons at the atoms to induce nuclear fission.
        `
    },

    level2: {
        title: "Level 2: Increased Difficulty",
        description: `
            Atoms are faster and have more health.

            Plan your shots carefully and try to
            minimize the number of neutrons used.
        `
    },

    level3: {
        title: "Level 3: Advanced Challenge",
        description: `
            You are now facing a more challenging
            and realistic simulation.

            You cannot aim the cannon. Time your shots wisely.
        `
    },

};

// =========================================
// Instructions Modal
// =========================================

function initializeInstructions() {

    if (
        !(instructionsModal instanceof HTMLElement) ||
        !(openInstructions instanceof HTMLButtonElement) ||
        !(closeInstructions instanceof HTMLButtonElement)
    ) {
        return;
    }

    function openModal() {
        instructionsModal.style.display = "flex";
        instructionsModal.setAttribute("aria-hidden", "false");
        closeInstructions.focus();
    }

    function closeModal() {
        instructionsModal.style.display = "none";
        instructionsModal.setAttribute("aria-hidden", "true");
        openInstructions.focus();
    }

    openInstructions.addEventListener("click", openModal);
    closeInstructions.addEventListener("click", closeModal);

    instructionsModal.addEventListener("click", (event) => {
        if (event.target === instructionsModal) {
            closeModal();
        }
    });

    document.addEventListener("keydown", (event) => {

        if (
            event.key === "Escape" &&
            instructionsModal.style.display === "flex"
        ) {
            closeModal();
        }

    });

    // Display instructions when the game first loads
    openModal();

}

// =========================================
// Level Description
// =========================================

function updateLevelDescription(levelName) {

    const level = levelDescriptions[levelName];

    const title = document.querySelector("#level-description-title");
    const description = document.querySelector("#level-description-text");

    if (!level || !title || !description) {
        return;
    }

    title.textContent = level.title;
    description.textContent = level.description.trim();

}

// =========================================
// Level Controls
// =========================================

function updateLevelControls() {

    const isLevel0 =
        levelSelector instanceof HTMLSelectElement &&
        levelSelector.value === "level0";

    // Only show Level 4 controls in Level 4
    if (level0Controls instanceof HTMLElement) {
        level0Controls.style.display = isLevel0 ? "flex" : "none";
    }

}

function resetLevel0Controls() {

    if (temperatureSlider instanceof HTMLInputElement) {
        temperatureSlider.value = "298";
    }

    if (temperatureValue) {
        temperatureValue.textContent = "298 K";
    }

    if (atomSlider instanceof HTMLInputElement) {
        atomSlider.value = "5";
    }

    if (atomValue) {
        atomValue.textContent = "5";
    }

}

// =========================================
// Cannon Customization
// =========================================

function initializeCannonCustomization(game) {

    // Change cannon colour
    if (cannonColor instanceof HTMLInputElement) {

        cannonColor.addEventListener("input", () => {
            game.setCannonColor(cannonColor.value);
        });

    }

    // Change cannon emoji
    if (cannonEmoji instanceof HTMLSelectElement) {

        cannonEmoji.addEventListener("change", () => {
            game.setCannonEmoji(cannonEmoji.value);
        });

    }

    // Reset cannon appearance
    if (resetCannon instanceof HTMLButtonElement) {

        resetCannon.addEventListener("click", () => {

            game.resetCannonAppearance();

            if (cannonColor instanceof HTMLInputElement) {
                cannonColor.value = "#555555";
            }

            if (cannonEmoji instanceof HTMLSelectElement) {
                cannonEmoji.value = "";
            }

        });

    }

}

// =========================================
// Level Selection
// =========================================

function initializeLevelSelection(game) {

    if (!(levelSelector instanceof HTMLSelectElement)) {
        return;
    }

    levelSelector.addEventListener("change", () => {

        const selectedLevel = levelSelector.value;

        // Update interface
        updateLevelControls();
        updateLevelDescription(selectedLevel);

        // Load selected level
        if (typeof game.setLevel === "function") {
            game.setLevel(selectedLevel);
        }

        // Reset sandbox settings when entering Level 0
        if (selectedLevel === "level0") {
            resetLevel0Controls();
        }

        if (canvas instanceof HTMLCanvasElement) {
            canvas.focus();
        }

    });

}

// =========================================
// Temperature Control
// =========================================

function initializeTemperatureControl(game) {

    if (
        !(temperatureSlider instanceof HTMLInputElement) ||
        !temperatureValue
    ) {
        return;
    }

    temperatureSlider.addEventListener("input", () => {

        const temperature = Number(temperatureSlider.value);

        temperatureValue.textContent = `${temperature} K`;

        if (
            levelSelector instanceof HTMLSelectElement &&
            levelSelector.value === "level0"
        ) {
            game.setTemperature(temperature);
        }

    });

}

// =========================================
// Atom Count Control
// =========================================

function initializeAtomCountControl(game) {

    if (
        !(atomSlider instanceof HTMLInputElement) ||
        !atomValue
    ) {
        return;
    }

    atomSlider.addEventListener("input", () => {
        atomValue.textContent = atomSlider.value;
    });

    atomSlider.addEventListener("change", () => {

        const count = Number(atomSlider.value);

        if (
            levelSelector instanceof HTMLSelectElement &&
            levelSelector.value === "level0"
        ) {
            game.setAtomCount(count);
        }

    });

}

// =========================================
// Game Buttons
// =========================================

function initializeGameButtons(game) {

    if (
        !(canvas instanceof HTMLCanvasElement) ||
        !(startButton instanceof HTMLButtonElement) ||
        !(pauseButton instanceof HTMLButtonElement) ||
        !(restartButton instanceof HTMLButtonElement)
    ) {
        return;
    }

    canvas.addEventListener("click", () => {
        canvas.focus();
    });

    // Start
    startButton.addEventListener("click", () => {

        if (!game.running) {
            game.start();
        }

        canvas.focus();

    });

    // Pause / Resume
    pauseButton.addEventListener("click", () => {

        if (game.state === "playing") {
            game.pause();
        }
        else if (game.state === "paused") {
            game.resume();
        }

        canvas.focus();

    });

    // Restart
    restartButton.addEventListener("click", () => {

        game.restart();
        canvas.focus();

    });

}

// =========================================
// Keyboard Controls
// =========================================

function initializeKeyboardControls() {

    const gameKeys = [
        "ArrowUp",
        "ArrowDown",
        "ArrowLeft",
        "ArrowRight",
        " ",
        "w",
        "a",
        "s",
        "d",
        "W",
        "A",
        "S",
        "D"
    ];

    document.addEventListener("keydown", (event) => {

        const target = event.target;

        // Avoid interfering with form controls
        if (
            target instanceof HTMLInputElement ||
            target instanceof HTMLSelectElement ||
            target instanceof HTMLTextAreaElement
        ) {
            return;
        }

        if (gameKeys.includes(event.key)) {
            event.preventDefault();
        }

    });

}

// =========================================
// Game Initialization
// =========================================

function initializeGame() {

    if (
        !(canvas instanceof HTMLCanvasElement) ||
        !(startButton instanceof HTMLButtonElement) ||
        !(pauseButton instanceof HTMLButtonElement) ||
        !(restartButton instanceof HTMLButtonElement)
    ) {
        return;
    }

    // Create game instance
    const game = new NuclearGame(canvas);

    // Initialize interface controls
    initializeCannonCustomization(game);
    initializeLevelSelection(game);
    initializeTemperatureControl(game);
    initializeAtomCountControl(game);
    initializeGameButtons(game);

    // Set initial interface state
    updateLevelControls();

    updateLevelDescription(
        levelSelector instanceof HTMLSelectElement
            ? levelSelector.value
            : "level1"
    );

}

// =========================================
// Initialize Everything
// =========================================

initializeInstructions();
initializeGame();
initializeKeyboardControls();

</script>

<style>

/* =========================================
   Theme Variables
========================================= */

:root {
    --game-border: #ccc;
    --game-background: #f5f5f5;
    --game-text: #333;

    --game-radius: 8px;
    --game-gap: 20px;

    --description-width: 180px;
    --controls-width: 180px;
    --canvas-max-width: 600px;
}

/* =========================================
   Game Header
========================================= */

.game-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
}

.game-header h1 {
    margin: 0;
}

.instructions-button {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 22px;
    height: 22px;
    padding: 0;

    border: 2px solid currentColor;
    border-radius: 50%;

    background: transparent;
    color: inherit;

    font-family: serif;
    font-size: 15px;
    font-weight: bold;
    font-style: italic;

    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
}

.instructions-button:hover {
    background: currentColor;
    color: white;
}

/* =========================================
   Main Game Layout
========================================= */

.game-container {
    display: grid;

    grid-template-columns:
        minmax(var(--description-width), 1fr)
        minmax(0, var(--canvas-max-width))
        minmax(var(--controls-width), 1fr);

    gap: var(--game-gap);

    width: 95%;
    margin: 2rem auto;

    align-items: start;
}

/* =========================================
   Level Description
========================================= */

#level-description {
    grid-column: 1;

    padding: 20px;

    background: var(--game-background);
    border: 1px solid var(--game-border);
    border-radius: var(--game-radius);

    box-sizing: border-box;
}

#level-description h2 {
    margin: 0 0 15px;
    font-size: 20px;
}

#level-description p {
    margin: 0;
    line-height: 1.6;
    white-space: pre-line;
}

/* =========================================
   Game Canvas Container
========================================= */

.game-canvas-container {
    grid-column: 2;

    display: flex;
    flex-direction: column;
    gap: 12px;

    width: 100%;
    min-width: 0;
}

#gameCanvas {
    display: block;

    width: 100%;
    height: auto;

    border: 2px solid var(--game-text);
    background: var(--game-background);
}

/* =========================================
   Game Controls
========================================= */

.game-controls {
    grid-column: 3;

    display: flex;
    flex-direction: column;
    gap: 15px;

    width: 100%;
}

.control-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.game-controls label {
    display: block;
}

.game-controls input,
.game-controls select {
    width: 100%;
    box-sizing: border-box;
    margin: 5px 0 15px;
}

.game-controls select {
    padding: 8px;
    cursor: pointer;
}

.game-controls button {
    width: 100%;
    padding: 10px;
    cursor: pointer;
}

/* Game Buttons */

.game-buttons {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

/* Level-Specific Controls */

.level0-controls {
    display: none;
    flex-direction: column;
    gap: 10px;
}

/* =========================================
   Cannon Customization
========================================= */

.cannon-settings {
    display: flex;
    flex-direction: column;
    gap: 12px;

    width: 100%;
    padding: 16px;

    background: var(--game-background);
    border: 1px solid var(--game-border);
    border-radius: var(--game-radius);

    box-sizing: border-box;
}

.cannon-settings h3 {
    margin: 0 0 5px;
    font-size: 17px;
}

.settings-row {
    display: flex;
    gap: 20px;
    align-items: center;
}

.setting {
    display: flex;
    flex-direction: column;
    gap: 5px;
    flex: 1;
    min-width: 0;
}

.setting label {
    font-size: 14px;
    font-weight: 600;
}

.setting input[type="color"] {
    width: 65px;
    height: 38px;
    padding: 2px;

    border: 1px solid var(--game-border);
    border-radius: 5px;

    background: white;
    cursor: pointer;
}

.setting select {
    width: 100%;
    padding: 8px;
    box-sizing: border-box;
}

.cannon-settings button {
    width: 100%;
    padding: 9px;

    border: 1px solid #bbb;
    border-radius: 5px;

    background: white;
    color: var(--game-text);

    cursor: pointer;
    transition: background-color 0.2s;
}

.cannon-settings button:hover {
    background: #e5e5e5;
}

/* =========================================
   Instructions Modal
========================================= */

.instructions-modal {
    display: none;

    position: fixed;
    inset: 0;
    z-index: 1000;

    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(0, 0, 0, 0.7);
}

.instructions-content {
    position: relative;

    width: 100%;
    max-width: 600px;

    max-height: 80vh;
    overflow-y: auto;

    padding: 30px;

    background: white;
    border-radius: 10px;

    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
}

.instructions-content h2 {
    margin: 0 0 20px;
}

.close-instructions {
    position: absolute;
    top: 10px;
    right: 15px;

    border: none;
    background: none;

    font-size: 28px;
    cursor: pointer;
}

.close-instructions:hover {
    color: #777;
}

/* =========================================
   Tablet Layout
========================================= */

@media (max-width: 1000px) {

    .game-container {
        grid-template-columns:
            minmax(0, 1fr)
            minmax(0, 2fr);
    }

    #level-description {
        grid-column: 1;
    }

    .game-canvas-container {
        grid-column: 2;
    }

    .game-controls {
        grid-column: 1 / -1;

        max-width: 400px;
        margin: 0 auto;
    }

}

/* =========================================
   Mobile Layout
========================================= */

@media (max-width: 650px) {

    .game-container {
        grid-template-columns: minmax(0, 1fr);
        width: 95%;
    }

    #level-description,
    .game-canvas-container,
    .game-controls {
        grid-column: 1;
    }

    .game-controls {
        max-width: 400px;
        margin: 0 auto;
    }

    .settings-row {
        flex-direction: column;
        align-items: stretch;
    }

}

</style>
