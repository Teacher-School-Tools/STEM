
---
const currentPath = Astro.props.currentPath ?? "/";

// Automatically discover every Astro page under src/pages/
const pageFiles = Object.keys(
  import.meta.glob("../pages/**/*.astro")
);

// Convert folder and file names into readable labels
function formatName(name) {
  return name
    .replace(/\.(astro|md|mdx)$/, "")
    .replace(/^\d+-/, "")
    .replace(/[-_]/g, " ")
    .replace(/\b\w/g, (char) => char.toUpperCase());
}

// Ensure the base URL ends with exactly one slash
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// Convert a file path into its website route
function getHref(relativePath) {
  const route = relativePath
    .replace(/\.(astro|md|mdx)$/, "")
    .replace(/\/index$/, "");

  return route ? `${base}${route}/` : base;
}

// Group pages by their first folder inside src/pages/
const categoryMap = new Map();

for (const file of pageFiles) {
  const relativePath = file
    .replace(/^.*\/pages\//, "")
    .replace(/^\.\.\/pages\//, "")
    .replace(/\.(astro|md|mdx)$/, "");

  const parts = relativePath.split("/");

  // Ignore files directly inside src/pages/
  if (parts.length < 2) continue;

  const folder = parts[0];

  if (!categoryMap.has(folder)) {
    // Remove numeric prefix for the category's display name
    categoryMap.set(folder, {
      name: formatName(folder),
      href: `${base}${folder}/`,
      pages: [],
    });
  }

  // The category's index page is its landing page
  if (parts.length === 2 && parts[1] === "index") {
    categoryMap.get(folder).href = `${base}${folder}/`;
    continue;
  }

  const pageName = parts[parts.length - 1];

  // Ignore index files in nested folders to avoid duplicate links
  if (pageName === "index") continue;

  categoryMap.get(folder).pages.push({
    name: formatName(pageName),
    href: getHref(relativePath),
  });
}

// Sort categories by numeric prefix, then alphabetically
const categories = [...categoryMap.entries()]
  .sort(([folderA], [folderB]) => {
    const getOrder = (folder) => {
      const match = folder.match(/^(\d+)-/);
      return match ? Number(match[1]) : Infinity;
    };

    return (
      getOrder(folderA) - getOrder(folderB) ||
      folderA.localeCompare(folderB)
    );
  })
  .map(([, category]) => category);

// Sort pages within each category alphabetically
for (const category of categories) {
  category.pages.sort((a, b) => a.name.localeCompare(b.name));
}
---

<aside class="sidebar" id="sidebar">
  <button
    class="sidebar-toggle"
    id="sidebar-toggle"
    aria-label="Collapse sidebar"
    aria-expanded="true"
    aria-controls="sidebar-content"
  >
    <span class="toggle-icon">☰</span>
    <span class="toggle-label"></span>
  </button>

  <nav id="sidebar-content" aria-label="Main navigation">
    {categories.map((category) => (
      <section class="sidebar-category">
        <a class="category-heading" href={category.href}>
          {category.name}
        </a>

        <div class="subcategory-list">
          {category.pages.map((page) => (
            <a
              class:list={[
                "subcategory",
                { active: currentPath.replace(/\/$/, "") === page.href.replace(/\/$/, "") },
              ]}
              href={page.href}
            >
              {page.name}
            </a>
          ))}
        </div>
      </section>
    ))}
  </nav>
</aside>




<script>
  const initializeSidebar = () => {
  const sidebar = document.querySelector("#sidebar");
  const toggle = document.querySelector("#sidebar-toggle");

  if (!sidebar || !toggle) return;

  const storageKey = "sidebar-collapsed";

  // Restore the saved sidebar state
  const isCollapsed = sessionStorage.getItem(storageKey) === "true";

  sidebar.classList.toggle("collapsed", isCollapsed);

  const updateToggle = (collapsed) => {
    toggle.setAttribute("aria-expanded", String(!collapsed));
    toggle.setAttribute(
      "aria-label",
      collapsed ? "Expand sidebar" : "Collapse sidebar"
    );
  };

  updateToggle(isCollapsed);

  // Avoid registering duplicate event listeners
  if (sidebar.dataset.initialized === "true") return;
  sidebar.dataset.initialized = "true";

  // Toggle button: expand or collapse
  toggle.addEventListener("click", (event) => {
    event.stopPropagation();

    const collapsed = sidebar.classList.toggle("collapsed");

    sessionStorage.setItem(storageKey, String(collapsed));
    updateToggle(collapsed);
  });

  // Clicking elsewhere on the sidebar only expands it
  sidebar.addEventListener("click", (event) => {
    if (event.target.closest("#sidebar-toggle")) return;

    if (sidebar.classList.contains("collapsed")) {
      sidebar.classList.remove("collapsed");

      sessionStorage.setItem(storageKey, "false");
      updateToggle(false);
    }
  });
};

// Initialize on page load
initializeSidebar();

// Reinitialize after Astro client-side navigation
document.addEventListener("astro:page-load", initializeSidebar);
</script>



<style>

.sidebar {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 10;
  width: 300px;
  height: 100%;
  min-height: 100%;
  margin: 0;
  overflow: hidden;
  overflow-y: hidden;
  overflow-x: hidden;
  box-sizing: border-box;
  background-color: aliceblue;
  transition: width 0.2s ease-in-out;
}

.sidebar.collapsed {
  width: 44px;
}

/* Navigation links */
.category-heading,
.subcategory {
  display: block;
  padding: 10px 12px;
  color: inherit;
  text-decoration: none;
  opacity: 1;
  transition: opacity 0.2s ease-in-out;
}

.category-heading {
  font-size: 1rem;
  font-weight: 600;
}

.subcategory {
  padding: 8px 12px 8px 28px;
  font-size: 0.99rem;
  font-weight: 400;
  opacity: 0.8;
}

/* Sidebar toggle */
.sidebar-toggle {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 10px;
  width: 100%;
  height: 40px;
  padding: 0 10px;
  margin-bottom: 12px;
  box-sizing: border-box;
  background: transparent;
  border: none;
  border-radius: 6px;
  color: inherit;
  font: inherit;
  cursor: pointer;
}

.sidebar-toggle:hover {
  background-color: rgba(128, 128, 128, 0.12);
}

.sidebar-toggle:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: -2px;
}

.toggle-icon {
  display: flex;
  flex: 0 0 24px;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  font-size: 1.2rem;
  line-height: 1;
}

/* Collapsed state */
.sidebar.collapsed .category-heading,
.sidebar.collapsed .subcategory-list {
  opacity: 0;
  pointer-events: none;
  transition: none;
}

/* Expanded state */
.sidebar:not(.collapsed) .category-heading,
.sidebar:not(.collapsed) .subcategory-list {
  transition: opacity 0.2s ease 0.1s;
}


</style>
