
---
const currentPath = decodeURIComponent(Astro.url.pathname);

function normalizePath(path) {
    return path.replace(/\/+$/, "") || "/";
}

// Deployment prefix
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Remove deployment prefix from URL
const localPath = normalizePath(
    currentPath.startsWith(base + "/")
        ? currentPath.substring(base.length)
        : currentPath
);

// Discover all Astro pages
const pageFiles = Object.keys(
    import.meta.glob("../pages/**/*.astro")
).map(path => path.replace(/\\/g, "/"));

// Convert files into page objects
const allPages = pageFiles.map(path => {
    const relativePath = path
        .replace("../pages/", "")
        .replace(/\.astro$/, "");

    const parts = relativePath.split("/");
    const filename = parts.pop();

    const directory = "/" + parts.join("/");

    const route = filename === "index"
        ? directory
        : directory + "/" + filename;

    return {
        filename,
        directory: normalizePath(directory),
        route: normalizePath(route)
    };
});

// Find current page
const currentPage = allPages.find(page =>
    normalizePath(page.route) === localPath
);

// Check whether viewing the main index page
const isMainIndex =
    currentPage?.filename === "index" &&
    currentPage?.directory === "/";

// Determine current directory
const currentDirectory = currentPage
    ? currentPage.directory
    : "/";

// Populate sidebar
const sidebarPages = allPages
    .filter(page => {
        // Main index: include all directory pages
        if (isMainIndex) {
            return page.route !== "/";
        }

        // Other pages: include pages in the same directory
        return page.directory === currentDirectory;
    })
    .map(page => {
        const numberMatch = page.filename.match(/^(\d+)-/);

        // Generate readable page names
        const name = page.filename === "index"
            ? page.directory.split("/").filter(Boolean).pop()
                ?.replace(/^\d+-/, "")
                .replace(/[-_]/g, " ")
                .replace(/\b\w/g, char => char.toUpperCase()) || "Home"
            : page.filename
                .replace(/^\d+-/, "")
                .replace(/[-_]/g, " ")
                .replace(/\b\w/g, char => char.toUpperCase());

        return {
            name,
            href: base + page.route,
            order: numberMatch
                ? Number(numberMatch[1])
                : page.filename === "index" ? 0 : Infinity,
            directory: page.directory,
            active: page.route === localPath,
            isIndex: page.filename === "index"
        };
    })
    .sort((a, b) => {
        // Group pages by directory on the main index
        if (isMainIndex && a.directory !== b.directory) {
            return a.directory.localeCompare(b.directory);
        }

        if (a.order !== b.order) {
            return a.order - b.order;
        }

        return a.name.localeCompare(b.name);
    });
---

<aside class="sidebar" id="sidebar">

    <div
        class="sidebar-header"
        id="sidebar-toggle"
        role="button"
        tabindex="0"
        aria-label="Collapse sidebar"
        aria-expanded="true"
    >
        <span class="sidebar-title">Contents</span>
        <span class="sidebar-toggle-arrow" id="toggle-arrow">☰</span>
    </div>

    <nav class="sidebar-nav">
        {sidebarPages.map(page => (
            <a
                href={page.href}
                class:list={[
                    "sidebar-link",
                    {
                        "index-page": page.isIndex,
                        "active": page.active
                    }
                ]}
            >
                {page.name}
            </a>
        ))}

        {sidebarPages.length === 0 && (
            <p>No pages found in this directory.</p>
        )}
    </nav>

</aside>

<script>
    const sidebar = document.querySelector("#sidebar");
    const sidebarToggle = document.querySelector("#sidebar-toggle");
    const mainContainer = document.querySelector(".main-container");

    const STORAGE_KEY = "sidebarCollapsed";

    // Restore saved sidebar state
    const savedState = localStorage.getItem(STORAGE_KEY);
    const initiallyCollapsed = savedState === "true";

    sidebar?.classList.toggle("collapsed", initiallyCollapsed);

    mainContainer?.classList.toggle(
        "sidebar-collapsed",
        initiallyCollapsed
    );

    // Update accessibility information
    function updateToggle() {
        const collapsed = sidebar?.classList.contains("collapsed");

        sidebarToggle?.setAttribute(
            "aria-expanded",
            String(!collapsed)
        );

        sidebarToggle?.setAttribute(
            "aria-label",
            collapsed ? "Expand sidebar" : "Collapse sidebar"
        );
    }

    // Toggle sidebar
    function toggleSidebar() {
        sidebar?.classList.toggle("collapsed");

        const collapsed = sidebar?.classList.contains("collapsed") ?? false;

        // Update main layout grid
        mainContainer?.classList.toggle(
            "sidebar-collapsed",
            collapsed
        );

        // Save state
        localStorage.setItem(
            STORAGE_KEY,
            String(collapsed)
        );

        updateToggle();
    }

    // Click anywhere on header
    sidebarToggle?.addEventListener("click", toggleSidebar);

    // Keyboard accessibility
    sidebarToggle?.addEventListener("keydown", event => {
        if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            toggleSidebar();
        }
    });

    // Set initial accessibility state
    updateToggle();
</script>

<style>

/* =========================================
   Sidebar
========================================= */

.sidebar {
    display: flex;
    flex-direction: column;

    position: relative;

    width: 260px;
    min-width: 260px;

    height: 100%;
    min-height: 0;
    max-height: 100%;

    box-sizing: border-box;
    overflow: hidden;

    background-color: aliceblue;

    transition:
        width 0.25s ease,
        min-width 0.25s ease;
}

/* =========================================
   Header
========================================= */

.sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    position: relative;

    width: 100%;
    height: 45px;
    min-height: 45px;
    max-height: 45px;

    flex: 0 0 45px;

    padding: 12px;
    box-sizing: border-box;

    background: transparent;

    cursor: pointer;
    user-select: none;

    z-index: 2;
}

.sidebar-header:hover {
    background-color: #e4eef8;
}

/* Header title */

.sidebar-title {
    font-size: 1.1rem;
    font-weight: bold;
    white-space: nowrap;

    opacity: 1;
    visibility: visible;

    transition:
        opacity 0.2s ease 0.3s,
        visibility 0s linear 0.3s;
}

/* Toggle symbol */

.sidebar-toggle-arrow {
    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    width: 24px;
    height: 24px;

    font-size: 1.3rem;
    line-height: 1;

    transform: rotate(90deg);
    transition: transform 0.3s ease;
}

/* =========================================
   Navigation
========================================= */

.sidebar-nav {
    display: flex;
    flex-direction: column;
    align-items: stretch;

    width: 100%;

    flex: 1 1 0;
    min-height: 0;
    max-height: 100%;

    padding: 5px 10px;
    gap: 3px;

    box-sizing: border-box;

    /* Remove scrollbar */
    overflow: hidden;

    background: transparent;
}

/* Navigation links */

.sidebar-link {
    display: block;

    width: 100%;
    padding: 10px 12px;

    flex-shrink: 0;

    box-sizing: border-box;

    color: #333;
    text-decoration: none;

    border-radius: 5px;

    font-size: 0.95rem;
    line-height: 1.4;

    white-space: normal;

    opacity: 1;
    visibility: visible;

    transition:
        opacity 0.2s ease 0.3s,
        visibility 0s linear 0.3s;
}

.sidebar-link:hover {
    background-color: #dce8f5;
}

/* Active page */

.sidebar-link.active {
    background-color: #c9dced;
    font-weight: bold;
}

/* Directory index pages */

.sidebar-link.index-page {
    font-weight: bold;
}

/* =========================================
   Collapsed Sidebar
========================================= */

.sidebar.collapsed {
    width: 44px;
    min-width: 44px;
    max-width: 44px;

    height: 100%;
    min-height: 0;
    max-height: 100%;

    overflow: hidden;

    background-color: aliceblue;
}

/* Collapsed header */

.sidebar.collapsed .sidebar-header {
    justify-content: center;
    align-items: flex-start;

    width: 44px;
    height: 45px;
    min-height: 45px;

    padding: 10px 0 0;

    flex: 0 0 45px;
}

/* Hide header title immediately */

.sidebar.collapsed .sidebar-title {
    display: none;

    opacity: 0;
    visibility: hidden;

    transition: none;
}

/* Hide navigation text immediately */

.sidebar.collapsed .sidebar-link,
.sidebar.collapsed .sidebar-nav p {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition: none;
}

/* Keep toggle symbol visible */

.sidebar.collapsed .sidebar-toggle-arrow {
    display: flex;

    justify-content: center;
    align-items: center;

    width: 44px;
    height: 24px;

    margin: 0;
    padding: 0;

    visibility: visible;
    opacity: 1;

    transform: rotate(0deg);
}

/* =========================================
   Expanded Sidebar
========================================= */

.sidebar:not(.collapsed) {
    width: 260px;
    min-width: 260px;

    background-color: aliceblue;
}

.sidebar:not(.collapsed) .sidebar-title,
.sidebar:not(.collapsed) .sidebar-link,
.sidebar:not(.collapsed) .sidebar-nav p {
    opacity: 1;
    visibility: visible;

    transition:
        opacity 0.2s ease 0.3s,
        visibility 0s linear 0.3s;
}

.sidebar:not(.collapsed) .sidebar-header {
    justify-content: space-between;
    align-items: center;
}

.sidebar:not(.collapsed) .sidebar-toggle-arrow {
    transform: rotate(90deg);
}

/* =========================================
   Sidebar Space
========================================= */

.sidebar-space {
    grid-column: 1;
    grid-row: 1;

    position: relative;

    width: 100%;
    min-width: 0;
    height: 100%;
    min-height: 0;

    overflow: hidden;

    background-color: aliceblue;
}

</style>