---
const currentPath = decodeURIComponent(Astro.url.pathname);

function normalizePath(path) {
    return path.replace(/\/+$/, "") || "/";
}

// Deployment prefix
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Remove deployment prefix from URL
const localPath = normalizePath(
    currentPath.startsWith(base + "/")
        ? currentPath.substring(base.length)
        : currentPath
);

// Discover all Astro pages
const pageFiles = Object.keys(
    import.meta.glob("../pages/**/*.astro")
).map(path => path.replace(/\\/g, "/"));

// Convert files into page objects
const allPages = pageFiles.map(path => {

    const relativePath = path
        .replace("../pages/", "")
        .replace(/\.astro$/, "");

    const parts = relativePath.split("/");
    const filename = parts.pop();

    const directory = "/" + parts.join("/");

    const route = filename === "index"
        ? directory
        : directory + "/" + filename;

    return {
        filename,
        directory: normalizePath(directory),
        route: normalizePath(route)
    };
});

// Find current page
const currentPage = allPages.find(page =>
    normalizePath(page.route) === localPath
);

// Check whether viewing the main src/pages/index.astro
const isMainIndex =
    currentPage?.filename === "index" &&
    currentPage?.directory === "/";

// Determine current directory
const currentDirectory = currentPage
    ? currentPage.directory
    : "/";

// Populate sidebar
// Populate sidebar
const sidebarPages = allPages
    .filter(page => {

        // Main index: include all pages, including directory indexes
        if (isMainIndex) {
            return page.route !== "/";
        }

        // Other pages: include all pages in the same directory
        return page.directory === currentDirectory;
    })
    .map(page => {

        const numberMatch = page.filename.match(/^(\d+)-/);

        // Give index pages a readable name
        const name = page.filename === "index"
    ? page.directory.split("/").filter(Boolean).pop()
        ?.replace(/^\d+-/, "")
        .replace(/[-_]/g, " ")
        .replace(/\b\w/g, char => char.toUpperCase()) || "Home"
    : page.filename
        .replace(/^\d+-/, "")
        .replace(/[-_]/g, " ")
        .replace(/\b\w/g, char => char.toUpperCase());

        return {
            name,
            href: base + page.route,
            order: numberMatch
                ? Number(numberMatch[1])
                : page.filename === "index" ? 0 : Infinity,
            directory: page.directory,
            active: page.route === localPath,
            isIndex: page.filename === "index"
        };
    })
    .sort((a, b) => {

        // Group pages by directory on the main index
        if (isMainIndex && a.directory !== b.directory) {
            return a.directory.localeCompare(b.directory);
        }

        if (a.order !== b.order) {
            return a.order - b.order;
        }

        return a.name.localeCompare(b.name);
    });
---
<aside class="sidebar" id="sidebar">

    <div class="sidebar-header" id="sidebar-toggle">
    <span class="sidebar-title">Contents</span>
    <span class="sidebar-toggle-arrow" id="toggle-arrow">☰</span>
</div>

    <nav class="sidebar-nav">
        {sidebarPages.map(page => (
            <a
    href={page.href}
    class:list={["sidebar-link", { "index-page": page.isIndex }]}
>
    {page.name}
</a>
        ))}

        {sidebarPages.length === 0 && (
            <p>No pages found in this directory.</p>
        )}
    </nav>

</aside>

<script>
    const sidebar = document.querySelector(".sidebar");
const sidebarToggle = document.querySelector("#sidebar-toggle");

sidebarToggle?.addEventListener("click", () => {
    sidebar?.classList.toggle("collapsed");

    const isCollapsed = sidebar?.classList.contains("collapsed");

    localStorage.setItem("sidebarCollapsed", isCollapsed ? "true" : "false");
});

    // Update toggle appearance
    function updateToggle() {
        const collapsed = sidebar?.classList.contains("collapsed");

        if (!toggle) return;

        toggle.textContent = collapsed ? "›" : "‹";

        toggle.setAttribute(
            "aria-expanded",
            String(!collapsed)
        );

        toggle.setAttribute(
            "aria-label",
            collapsed ? "Expand sidebar" : "Collapse sidebar"
        );
    }

    // Set initial appearance
    updateToggle();

    // Toggle and save state
    toggle?.addEventListener("click", () => {

        const collapsed = sidebar?.classList.toggle("collapsed");

        localStorage.setItem(
            "sidebar-collapsed",
            String(collapsed)
        );

        updateToggle();
    });
</script>


<style>
/* =========================================
   Sidebar
========================================= */

.sidebar {
    width: 260px;
    min-width: 260px;
    height: 100%;

    display: flex;
    flex-direction: column;

    background: aliceblue;
    overflow: hidden;

    transition:
        width 0.25s ease,
        min-width 0.25s ease;
}

/* =========================================
   Header
========================================= */

.sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    min-height: 45px;
    padding: 12px;
    box-sizing: border-box;

    cursor: pointer;
}

.sidebar-title {
    font-size: 1.1rem;
    font-weight: bold;
    white-space: nowrap;

    opacity: 1;
    visibility: visible;

    transition:
        opacity 0.2s ease 0.3s,
        visibility 0s linear 0.3s;
}

.collapse-button {
    border: none;
    background: transparent;

    font-size: 1.5rem;
    cursor: pointer;

    padding: 2px 8px;
}

.sidebar-toggle-arrow {
    display: inline-block;
    transform: rotate(-90deg);

    transition: transform 0.3s ease;
}

/* =========================================
   Navigation
========================================= */

.sidebar-nav {
    display: flex;
    flex-direction: column;
    align-items: stretch;

    width: 100%;
    overflow-y: auto;

    padding: 5px 10px;
    box-sizing: border-box;
    gap: 3px;
}

.sidebar-link {
    display: block;
    width: 100%;
    box-sizing: border-box;

    padding: 10px 12px;

    color: #333;
    text-decoration: none;

    border-radius: 5px;
    font-size: 0.95rem;
    line-height: 1.4;
    white-space: normal;
}

.sidebar-link:hover {
    background: #dce8f5;
}

.sidebar-link.active {
    background: #c9dced;
    font-weight: bold;
}

.sidebar-link.index-page {
    font-weight: bold;
}

/* =========================================
   Collapsed Sidebar
========================================= */

.sidebar.collapsed {
    width: 44px;
    min-width: 44px;
}

/* Hide navigation when collapsed */

.sidebar.collapsed .sidebar-link,
.sidebar.collapsed .sidebar-nav p {
    display: none;
}

/* Header alignment */

.sidebar.collapsed .sidebar-header {
    justify-content: center;
    padding: 5px 0;
}

.sidebar.collapsed .collapse-button {
    padding: 5px;
}

/* Hide title when collapsed */

.sidebar.collapsed .sidebar-title {
    opacity: 0;
    visibility: hidden;

    transition:
        opacity 0.2s ease,
        visibility 0s linear 0.3s;
}

</style>