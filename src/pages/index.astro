---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeaderDropdown from '../components/HeaderDropdown.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<!-- <Header /> -->
		<HeaderDropdown/>
		<main>
			<h1>Welcome to SCH3U!</h1>
			<p>
				This website hosts various resources, lesson plans, and content covering the grade 11 university stream chemistry course. Use the section headers at the top to find content regarding the 5 course specific streams for grade 11 chemistry.
			</p>
			<h2>
				Content Covered
			</h2>
			<p>
				The content covered in this website is as follows:
			</p>
			<h3><a href=`..${base}/Chemical Reactions``>Chemical Reactions</a></h3>
			<p>Chemical Reactions content covered</p>
			<h3><a href=`..${base}/Gases and Atmospheric Chemistry`>Gases and Atmospheric Chemistry</a></h3>
			<p>Gases and Atmospheric Chemistry Content Covered</p>
			<h3><a href=`..${base}/Matter & Chemical Trends & Chemical Bonding`>Matter, Trends & Bonding</a></h3>
			<p>Matter content</p>
			<h3><a href=`..${base}/Quantities in Chemical Reactions`>Quantities in Chemical Reactions</a></h3>
			<p>Reactions content</p>
			<h3><a href=`..${base}/Solutions and Solubility`>Solutions and Solubility</a></h3>
			<p>Solutions and Solubility Content</p>
			<!-- <p>
				STEM Capstone, built by Caelan Baron, Justin Bishop, Andrew Breau, Dhruv Dhoum, and Ricky Fan.

			</p> -->
		</main>
		<Footer />
	</body>
</html>
