---
import MainLayout from '../layouts/MainLayout.astro';
export const description = "TEMP"

const base = import.meta.env.BASE_URL;

// Automatically import descriptions from directory index pages
const pages = import.meta.glob(
    "/src/pages/**/index.astro",
    {
        eager: true,
        import: "description"
    }
);

const directories = Object.entries(pages)
    .map(([page, description]) => {
        const relativePath = page
            .replace("/src/pages/", "")
            .replace("/index.astro", "");

        // Ignore root index page
        if (!relativePath || relativePath === "index") {
            return null;
        }

        const name = relativePath
            .split("/")
            .pop()
            .replace(/^\d+-/, "");

        const href = base + "/" +
            relativePath
                .split("/")
                .map(segment =>
                    encodeURIComponent(segment).replace(/%26/g, "&")
                )
                .join("/") +
            "/";

        return {
            name,
            href,
            path: relativePath,
            desc: description ?? ""
        };
    })
    .filter(Boolean)
    .sort((a, b) =>
        a.path.localeCompare(b.path, undefined, {
            numeric: true
        })
    );
---

<MainLayout>
<section class="directory-list">
    <h1>Welcome to SCH3U!</h1>
<p>
				This website hosts various resources, 
				lesson plans, and content covering the grade 11 
				university stream chemistry course. Use the section 
				headers at the top to find content 
				regarding the 5 course specific streams for grade 11 chemistry.
			</p>
    <ul>
        {directories.map((directory) => (
            <li>
                <h2><a href={directory.href}>
                    {directory.name}
                </a></h2>
            </li>
			<p>{directory.desc}</p>
        ))}
    </ul>
</section>
</MainLayout>
<style>
    .directory-list ul {
        list-style: none;
        padding: 0;
    }

    .directory-list li {
        margin-bottom: 12px;
    }

    .directory-list a {
        text-decoration: none;
        color: inherit;
    }

    .directory-list a:hover {
        text-decoration: underline;
    }
</style>

---