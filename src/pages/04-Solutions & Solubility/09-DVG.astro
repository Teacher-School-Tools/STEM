---
import CurriculumExpectations from "../../components/CurriculumExpectations.astro"
import MainLayout from "../../layouts/MainLayout.astro";
export const description = "An defense game something something"
const base = import.meta.env.BASE_URL;
---
<MainLayout>

<h1>Titration Defense</h1>

    <div class="game-container">
        <iframe
            src={`${base}/TitrationDefense/index.html`}
			
            title="Titration Defense"
            allowfullscreen
        ></iframe>
    </div>

</MainLayout>
<style>
:global(html),
:global(body) {
    overflow: hidden;
    height: 100%;
}

.game-container {
    width: 100%;
    max-width: 1200px;
    height: 700px;
    margin: 0 auto;

    display: flex;
    justify-content: center;
    align-items: center;

    overflow: hidden;
    background: black;
}

iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
}

</style>