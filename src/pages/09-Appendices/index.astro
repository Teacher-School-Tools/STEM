---
import BaseHead from '../../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import MainLayout from '../../layouts/MainLayout.astro';
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

---

<!doctype html>
<html lang="en">
	<MainLayout>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<main>
			<h1>Appendices</h1>
            <p>Navigate the various additional webpages here.</p>
            <h2><a href=`${currentPath}glossary`>Glossary</a></h2>
            <p>All definitions can be found here.</p>
            <h2><a href=`${currentPath}references`>References</a></h2>
            <p>All references can be found here.</p>
		</main>
	</body>
	</MainLayout>
</html>
